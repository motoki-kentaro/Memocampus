# Rust build output (also contains the locally built host executable)
/native-host/target/
/visible-store/target/
/mcp-server/target/
/tray/target/

# Node
node_modules/

# SQLite vaults, backups and their sidecar files
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.db
*.db-shm
*.db-wal
*.db-journal
.memocampus-backup-*.partial

# Per-user Memocampus settings (normally under %LOCALAPPDATA%\Memocampus, never in the repo)
/config.json
/config.lock
/native-host/config.json
/native-host/config.lock

# Native Messaging host manifest generated by install-native-host.ps1 (machine path + extension ID).
# The committed template is native-host/com.memocampus.vault.template.json.
/native-host/com.memocampus.vault.json
/native-host/.com.memocampus.vault.*.tmp*

# Logs
*.log

# Local environment files and credentials
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.crx

# OS files
Thumbs.db
desktop.ini
.DS_Store

# Local security research PoCs (not for repository)
/poc/mcp-prompt-injection/
/poc/release-projection/
# Installer (Issue #67 Slice 3B-1): the staged copies and the built setup are never committed.
/installer/stage/
/installer/out/
/native-host/io.github.memocampus.vault.dev.json
/installer/out-test/
