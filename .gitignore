# Rust build output (also contains the locally built host executable)
/native-host/target/

# Node
node_modules/

# SQLite vaults, backups and their sidecar files
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.db
*.db-shm
*.db-wal
*.db-journal
.memocampus-backup-*.partial

# Per-user Memocampus settings (normally under %LOCALAPPDATA%\Memocampus, never in the repo)
/config.json
/config.lock
/native-host/config.json
/native-host/config.lock

# Native Messaging host manifest generated by install-native-host.ps1 (machine path + extension ID).
# The committed template is native-host/com.memocampus.vault.template.json.
/native-host/com.memocampus.vault.json
/native-host/.com.memocampus.vault.*.tmp*

# Logs
*.log

# Local environment files and credentials
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.crx

# OS files
Thumbs.db
desktop.ini
.DS_Store
